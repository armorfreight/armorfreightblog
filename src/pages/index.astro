---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { organizationSchema, websiteSchema } from '../lib/seo';
import { withJournalTracking } from '../lib/tracking';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const featured = posts[0];
const featuredId = featured?.id;
const latest = posts.filter((post) => post.id !== featuredId).slice(0, 3);

const latestIds = new Set(latest.map((post) => post.id));
const curatedPriority = ['Customer Service', 'LTL', 'Operations'];
const curatedByTopic = curatedPriority.flatMap((topic) =>
  posts.filter((post) => post.id !== featuredId && !latestIds.has(post.id) && post.data.topic === topic).slice(0, 1)
);
const remainingCurated = posts.filter(
  (post) =>
    post.id !== featuredId &&
    !latestIds.has(post.id) &&
    !curatedByTopic.some((candidate) => candidate.id === post.id)
);
const curatedPosts = [...curatedByTopic, ...remainingCurated].slice(0, 3);

const slugify = (s) => s.toLowerCase().replace(/\s+/g, '-');
const usedTopics = new Set(
  posts.map((p) => p.data.topic).filter(Boolean).map(slugify)
);
const featuredUrl = featured ? withJournalTracking(`/blog/${featured.id}/`, 'homepage_featured_essay') : '/';
const primaryQuoteUrl = withJournalTracking('https://armorfreight.com/request-a-quote/', 'homepage_quote');

const topics = [
  ['Operations', 'when the plan breaks'],
  ['Customer service', 'why the broken load decides the relationship'],
  ['LTL', 'partial-load economics'],
  ['Truckload', 'the true cost of cheap'],
  ['Warehousing', 'what happens between the docks'],
  ['Retail logistics', 'the last mile to the shelf'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <JsonLd schema={websiteSchema} />
    <JsonLd schema={organizationSchema} />
  </head>
  <body class="bg-white text-[#050505]">
    <Header />
    <main>
      <section class="bg-[#050505]">
        <div class="mx-auto max-w-[1240px] px-5 py-16 md:px-8 md:py-20">
          <p class="text-[11px] font-semibold uppercase tracking-[0.35em] text-[#7db74e]">Armor Freight Journal</p>
          <div class="mt-8 max-w-4xl">
            <h1 class="font-display text-5xl leading-[0.92] text-white md:text-[72px] lg:text-[90px]">
              Freight, from the people who actually move it.
            </h1>
            <p class="mt-7 max-w-2xl text-xl font-medium leading-snug text-neutral-300 md:text-[24px] md:leading-[1.4]">
              Operational perspective from the road, the dock and the dispatch desk.
            </p>
            <div class="mt-10 flex flex-wrap gap-4">
              {featured && (
                <a
                  href={featuredUrl}
                  data-track-event="homepage_featured_click"
                  data-track-category="navigation"
                  data-track-label={featured.data.title}
                  class="inline-flex items-center justify-center bg-[#7db74e] px-6 py-[15px] text-[17px] font-medium uppercase tracking-[1.3px] text-[#050505] no-underline transition hover:bg-[#5f8f36]"
                  style="font-family: 'Bebas Neue', 'Arial Narrow', sans-serif; border-radius: 0 0 20px 0; line-height: 1;"
                >
                  Read the Journal →
                </a>
              )}
              <a
                href={primaryQuoteUrl}
                data-track-event="homepage_quote_click"
                data-track-category="conversion"
                data-track-label="Homepage quote"
                class="inline-flex items-center justify-center border border-white/30 bg-white/5 px-6 py-[15px] text-[17px] font-medium uppercase tracking-[1.3px] text-white no-underline transition hover:bg-white/10"
                style="font-family: 'Bebas Neue', 'Arial Narrow', sans-serif; border-radius: 0 0 20px 0; line-height: 1;"
              >
                Get a Quote
              </a>
            </div>
          </div>
        </div>
      </section>

      {featured && (
        <section class="mx-auto max-w-[1240px] px-5 py-16 md:px-8 md:py-20">
          <div class="flex items-center justify-between gap-4 border-b-4 border-[#050505] pb-3">
            <span class="text-[12px] font-semibold uppercase tracking-[0.25em] text-[#050505]">Featured essay</span>
            <span class="hidden text-[12px] font-semibold uppercase tracking-[0.2em] text-[#5f8f36] md:inline">Journal</span>
          </div>

          <div class="mt-8 grid gap-8 lg:grid-cols-[1.3fr_0.7fr] lg:items-end">
            <a
              href={featuredUrl}
              data-track-event="featured_article_click"
              data-track-category="navigation"
              data-track-label={featured.data.title}
              class="group block no-underline"
            >
              {featured.data.topic && (
                <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#5f8f36]">{featured.data.topic}</span>
              )}
              <h2 class="font-display mt-4 max-w-[12ch] text-4xl leading-[0.92] text-[#050505] transition group-hover:text-[#5f8f36] md:text-[70px]">
                {featured.data.title}
              </h2>
            </a>

            <div class="lg:pb-2">
              <p class="max-w-lg text-lg leading-relaxed text-neutral-700">{featured.data.description}</p>
              <p class="mt-4 text-sm font-medium text-neutral-600">By <a href="/authors/aaron-bartholomew/" class="font-semibold text-[#050505] underline underline-offset-2 hover:text-[#5f8f36]">Aaron Bartholomew</a> · Armor Freight Services</p>
              <div class="mt-6 flex flex-wrap items-center gap-4 border-t border-neutral-200 pt-4">
                <a
                  href={featuredUrl}
                  data-track-event="featured_article_read_more"
                  data-track-category="navigation"
                  data-track-label={featured.data.title}
                  class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#5f8f36] no-underline"
                >Read essay →</a>
                <span class="text-sm text-neutral-500"><FormattedDate date={featured.data.pubDate} /></span>
              </div>
            </div>
          </div>
        </section>
      )}

      {latest.length > 0 && (
        <section class="mx-auto max-w-[1240px] px-5 py-16 md:px-8 md:py-20">
          <div class="border-b-4 border-[#050505] pb-3">
            <span class="text-[12px] font-semibold uppercase tracking-[0.25em] text-[#050505]">Latest thinking</span>
          </div>
          <div class="mt-8 grid gap-6 lg:grid-cols-3">
            {latest.map((post) => {
              const href = withJournalTracking(`/blog/${post.id}/`, `latest_thinking:${post.id}`);
              return (
                <article class="border-t border-neutral-200 pt-5 transition hover:border-[#5f8f36]">
                  <a
                    href={href}
                    data-track-event="latest_thinking_click"
                    data-track-category="navigation"
                    data-track-label={post.data.title}
                    class="group block no-underline"
                  >
                    {post.data.topic && (
                      <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#5f8f36]">{post.data.topic}</span>
                    )}
                    <h3 class="font-display mt-3 text-[30px] leading-[0.96] text-[#050505] transition group-hover:text-[#5f8f36] md:text-[34px]">{post.data.title}</h3>
                    <p class="mt-3 text-base leading-relaxed text-neutral-700">{post.data.description}</p>
                    <p class="mt-3 text-sm font-medium text-neutral-600">By <a href="/authors/aaron-bartholomew/" class="font-semibold text-[#050505] underline underline-offset-2 hover:text-[#5f8f36]">Aaron Bartholomew</a> · Armor Freight Services</p>
                    <p class="mt-4 text-sm text-neutral-500"><FormattedDate date={post.data.pubDate} /></p>
                  </a>
                </article>
              );
            })}
          </div>
        </section>
      )}

      {curatedPosts.length > 0 && (
        <section class="mx-auto max-w-[1240px] px-5 py-16 md:px-8 md:py-20">
          <div class="border-b-4 border-[#050505] pb-3">
            <span class="text-[12px] font-semibold uppercase tracking-[0.25em] text-[#050505]">More from the journal</span>
          </div>
          <div class="mt-8 grid gap-6 md:grid-cols-3">
            {curatedPosts.map((post) => {
              const href = withJournalTracking(`/blog/${post.id}/`, `more_from_journal:${post.id}`);
              return (
                <article class="border-t border-neutral-200 pt-5 transition hover:border-[#5f8f36]">
                  <a
                    href={href}
                    data-track-event="more_from_journal_click"
                    data-track-category="navigation"
                    data-track-label={post.data.title}
                    class="group block no-underline"
                  >
                    {post.data.topic && (
                      <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#5f8f36]">{post.data.topic}</span>
                    )}
                    <h3 class="font-display mt-3 text-[28px] leading-[0.96] text-[#050505] transition group-hover:text-[#5f8f36] md:text-[32px]">{post.data.title}</h3>
                    <p class="mt-3 text-base leading-relaxed text-neutral-700">{post.data.description}</p>
                    <p class="mt-3 text-sm font-medium text-neutral-600">By <a href="/authors/aaron-bartholomew/" class="font-semibold text-[#050505] underline underline-offset-2 hover:text-[#5f8f36]">Aaron Bartholomew</a> · Armor Freight Services</p>
                    <p class="mt-4 text-sm text-neutral-500"><FormattedDate date={post.data.pubDate} /></p>
                  </a>
                </article>
              );
            })}
          </div>
        </section>
      )}

      <section class="mx-auto max-w-[1240px] px-5 py-16 md:px-8 md:py-20">
        <div class="flex items-baseline justify-between border-b-4 border-[#050505] pb-3">
          <span class="font-display text-2xl text-[#050505] md:text-[38px]">Browse by topic</span>
          <span class="text-[12px] font-semibold uppercase tracking-[0.25em] text-[#5f8f36]">The index</span>
        </div>
        <div class="mt-4 grid gap-3 md:grid-cols-2">
          {topics.filter(([name]) => usedTopics.has(slugify(name))).map(([name, gloss]) => (
            <a href={`/topics/${slugify(name)}/`} class="group flex items-center justify-between gap-4 border-b border-neutral-200 py-3 no-underline transition hover:text-[#5f8f36]">
              <div class="flex items-center gap-3">
                <span class="text-base font-extrabold uppercase tracking-[0.14em] text-[#050505] group-hover:text-[#5f8f36]">{name}</span>
              </div>
              <span class="text-sm italic text-[#5f8f36]">{gloss}</span>
            </a>
          ))}
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
