---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import NewsletterSignup from "../components/NewsletterSignup.astro";
import AuthorMeta from "../components/AuthorMeta.astro";

type Props = CollectionEntry<"blog">["data"];

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body class="bg-white text-[#050505]">
    <Header />

    <main class="mx-auto max-w-3xl px-5 py-16 md:px-8 md:py-20">
      {heroImage && (
        <Image
          src={heroImage}
          alt={title}
          width={1400}
          class="mb-10 rounded-[0_0_20px_0]"
        />
      )}

      <header class="mb-12 border-b-4 border-[#050505] pb-8">
        <p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-[#5f8f36]">
          Armor Freight Journal
        </p>

        <h1 class="font-display mt-5 text-5xl leading-[0.9] text-[#050505] md:text-[64px]">
          {title}
        </h1>

        <p class="mt-4 text-sm font-medium text-neutral-600">
          By <span class="font-semibold text-[#050505]">Aaron Bartholomew</span> · Armor Freight Services
        </p>

        <div class="mt-6 text-sm uppercase tracking-[0.12em] text-neutral-500">
          <FormattedDate date={pubDate} />
          {
            updatedDate && (
              <>
                {" • Updated "}
                <FormattedDate date={updatedDate} />
              </>
            )
          }
        </div>
      </header>

      <article class="prose prose-lg prose-neutral max-w-none">
        <slot />
      </article>

      <AuthorMeta className="mt-10" />

      <div class="mt-16 border-t border-neutral-200 pt-8">
        <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-[#5f8f36]">Need a quote?</p>
        <h2 class="font-display mt-3 text-3xl text-[#050505] md:text-4xl">Talk with the team</h2>
        <a
          href="https://armorfreight.com/request-a-quote/"
          class="mt-6 inline-flex items-center justify-center border border-[#050505] bg-[#050505] px-[15px] py-[15px] text-[17px] font-medium uppercase tracking-[1.3px] text-[#fffdfd] no-underline transition hover:bg-[#1d1d1d]"
          style="font-family: 'Bebas Neue', 'Arial Narrow', sans-serif; border-radius: 0 0 20px 0; line-height: 1;"
        >
          Get a Quote
        </a>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          <a href="mailto:operations@armorfreight.com?subject=Freight%20Quote" class="rounded-[0_0_20px_0] border border-neutral-200 bg-neutral-50 p-4 text-[#050505] no-underline transition hover:border-[#5f8f36] hover:bg-white">
            <div class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#5f8f36]">Email</div>
            <div class="mt-2 text-lg font-semibold">operations@armorfreight.com</div>
          </a>
          <a href="tel:+18885070767" class="rounded-[0_0_20px_0] border border-neutral-200 bg-neutral-50 p-4 text-[#050505] no-underline transition hover:border-[#5f8f36] hover:bg-white">
            <div class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#5f8f36]">Phone</div>
            <div class="mt-2 text-lg font-semibold">(888) 507-0767</div>
          </a>
        </div>
      </div>

      <div class="mt-16 border-t border-neutral-200 pt-6">
        <p class="text-sm leading-relaxed text-neutral-500">
          Written from inside <a href="https://armorfreight.com/about-armor-freight/" class="font-semibold text-[#5f8f36] underline underline-offset-2 hover:text-[#050505]">Armor Freight Services</a> by people who've driven the freight, booked the trucks, and solved the problems.
        </p>
      </div>

      <NewsletterSignup />
    </main>

    <Footer />
  </body>
</html>