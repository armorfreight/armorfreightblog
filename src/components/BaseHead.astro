---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font } from 'astro:assets';
import { SITE_TITLE } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  ogTitle?: string;
  ogDescription?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
}

const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://armorfreightblog.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;

// Site-wide default share image (branded shield). Lives in /public.
const DEFAULT_OG = new URL('/og-default.png', siteUrl).href;

const { title, description, image, ogTitle, ogDescription, type = 'website', publishedTime, modifiedTime } = Astro.props;
const ogImage = typeof image === 'string' ? image : image ? new URL(image.src, Astro.url).href : DEFAULT_OG;
const twitterCard = image ? 'summary_large_image' : 'summary';
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/png" href="/af-shield.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Teko:wght@400;500;600;700&family=Work+Sans:wght@400;500;600;700;800&display=swap"
	rel="stylesheet"
/>

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={ogTitle || title} />
<meta property="og:description" content={ogDescription || description} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content={SITE_TITLE} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter -->
<meta property="twitter:card" content={twitterCard} />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={ogTitle || title} />
<meta property="twitter:description" content={ogDescription || description} />
<meta property="twitter:image" content={ogImage} />

<script is:inline>
  window.dataLayer = window.dataLayer || [];
  window.gtag = window.gtag || function () {
    window.dataLayer.push(arguments);
  };

  if (!window.__armorFreightJournalGtagLoaded) {
    window.__armorFreightJournalGtagLoaded = true;

    const script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.googletagmanager.com/gtag/js?id=G-JQKRYJF4RS';
    script.onload = function () {
      window.gtag('js', new Date());
      window.gtag('config', 'G-JQKRYJF4RS');
    };
    document.head.appendChild(script);
  }

  function sendJournalClick(eventName, link) {
    const href = link.getAttribute('href') || '';
    const label = link.dataset.trackLabel || link.textContent?.trim() || 'journal-link';
    const category = link.dataset.trackCategory || 'cta';
    const payload = {
      event: eventName,
      category,
      label,
      href,
      source: 'armor_freight_journal'
    };

    window.dataLayer.push(payload);

    if (typeof window.gtag === 'function') {
      window.gtag('event', eventName, payload);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-track-event]').forEach((link) => {
      link.addEventListener('click', () => sendJournalClick(link.dataset.trackEvent, link));
    });
  });
</script>