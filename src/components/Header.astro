---
import { SITE_TITLE } from "../consts";
---

<header class="border-b border-[#e4e4dd] bg-white/95 backdrop-blur-sm">
  <nav class="mx-auto flex max-w-[1240px] items-center justify-between gap-4 px-5 py-4 md:px-8">
    <a href="/" class="flex items-center gap-3 no-underline">
      <img src="/af-shield.png" alt="" class="h-10 w-10 object-contain md:h-11 md:w-11" />
      <div class="leading-none">
        <span class="block text-[10px] font-semibold uppercase tracking-[0.26em] text-[#5f8f36]">Armor Freight</span>
        <span class="mt-1 block text-[14px] font-semibold uppercase tracking-[0.18em] text-[#050505]">{SITE_TITLE}</span>
      </div>
    </a>

    <div class="hidden items-center gap-7 text-[14px] font-medium tracking-[0.08em] text-[#050505] md:flex">
      <a href="/blog" class="no-underline text-[#050505] transition hover:text-[#5f8f36]">Articles</a>
      <a href="/topics/operations/" class="no-underline text-[#050505] transition hover:text-[#5f8f36]">Topics</a>
      <a href="/about" class="no-underline text-[#050505] transition hover:text-[#5f8f36]">About</a>
      <a href="https://armorfreight.com/" class="no-underline text-[#050505] transition hover:text-[#5f8f36]">Armor Freight</a>
    </div>

    <div class="flex items-center gap-3">
      <a href="tel:+18885070767" class="hidden text-[11px] font-semibold uppercase tracking-[0.18em] text-[#050505] no-underline transition hover:text-[#5f8f36] sm:inline">(888) 507-0767</a>
      <a
        href="https://armorfreight.com/request-a-quote/"
        class="inline-flex items-center justify-center border border-[#050505] bg-[#050505] px-[14px] py-[10px] text-[14px] font-medium uppercase tracking-[1.1px] text-[#fffdfd] no-underline transition hover:bg-[#1d1d1d]"
        style="font-family: 'Bebas Neue', 'Arial Narrow', sans-serif; border-radius: 0 0 18px 0; line-height: 1;"
      >
        Get a Quote
      </a>
    </div>
  </nav>
</header>