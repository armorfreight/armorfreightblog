---
import { SITE_TITLE } from "../consts";
---

<header class="border-b border-[#dfe3d8] bg-white">
  <nav class="mx-auto flex max-w-[1240px] items-center justify-between gap-6 px-5 py-4 md:px-8">
    <a href="/" class="flex items-center gap-3 no-underline">
      <img src="/af-shield.png" alt="" class="h-11 w-11 object-contain md:h-12 md:w-12" />
      <span class="text-[15px] font-semibold uppercase tracking-[0.18em] text-[#050505]">{SITE_TITLE}</span>
    </a>

    <div class="hidden items-center gap-8 text-[16px] font-medium text-[#7db74e] md:flex">
      <a href="/" class="no-underline text-[#7db74e] transition hover:text-[#5f8f36]">Home</a>
      <a href="/blog" class="no-underline text-[#7db74e] transition hover:text-[#5f8f36]">Articles</a>
      <a href="/about" class="no-underline text-[#7db74e] transition hover:text-[#5f8f36]">About</a>
    </div>

    <div class="flex items-center gap-3">
      <a href="tel:+18885070767" class="hidden text-sm font-semibold uppercase tracking-[0.12em] text-[#050505] no-underline transition hover:text-[#7db74e] sm:inline">(888) 507-0767</a>
      <a
        href="mailto:operations@armorfreight.com?subject=Freight%20Quote"
        class="inline-flex items-center justify-center border border-[#050505] bg-[#050505] px-[15px] py-[15px] text-[17px] font-medium uppercase tracking-[1.3px] text-[#fffdfd] no-underline transition hover:bg-[#1d1d1d]"
        style="font-family: 'Bebas Neue', 'Arial Narrow', sans-serif; border-radius: 0 0 20px 0; line-height: 1;"
      >
        Get a Quote
      </a>
    </div>
  </nav>
</header>