---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { withJournalTracking } from '../lib/tracking';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{posts.length > 0 && (
  <section class="mt-16 border-t border-neutral-200 pt-10">
    <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-[#5f8f36]">Keep reading</p>
    <h2 class="font-display mt-3 text-3xl text-[#050505] md:text-4xl">More from the journal</h2>

    <div class="mt-6 grid gap-4 md:grid-cols-3">
      {posts.map((post) => {
        const href = withJournalTracking(`/blog/${post.id}/`, `keep_reading:${post.id}`);
        return (
          <a
            href={href}
            data-track-event="keep_reading_click"
            data-track-category="navigation"
            data-track-label={post.data.title}
            class="group rounded-[0_0_20px_0] border border-neutral-200 bg-neutral-50 p-4 no-underline transition hover:border-[#5f8f36] hover:bg-white"
          >
            {post.data.topic && (
              <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-[#5f8f36]">{post.data.topic}</span>
            )}
            <h3 class="font-display mt-3 text-[28px] leading-[0.95] text-[#050505] transition group-hover:text-[#5f8f36] md:text-[32px]">
              {post.data.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700">{post.data.description}</p>
            <p class="mt-4 text-sm text-neutral-500"><FormattedDate date={post.data.pubDate} /></p>
          </a>
        );
      })}
    </div>
  </section>
)}
